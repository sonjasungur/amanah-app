# /opt/amanah-staging/ops.env — settings for scripts/staging-cron.sh (no secrets in this file).
BASE_URL=http://127.0.0.1:3201
DISK_MAX_PERCENT=85
BACKUP_MAX_AGE_HOURS=26
BACKUP_KEEP_DAYS=7
RESTORE_MAX_AGE_DAYS=2
OWNER_RESTORE_MAX_AGE_DAYS=35
# Separate restore-check key for the automatic nightly restore test (staging, synthetic data only;
# approved by the owner 31.10.). Public part is added to every backup next to the owner key; the
# private part stays on the server. Never use it for production. docs 29 §2.3
# RESTORE_CHECK_RECIPIENT=age1...
# AGE_IDENTITY=/root/.config/amanah-staging/restore-check.key
# Once HTTPS is live (variant B, docs 29 §4):
# CERT_HOST=staging.REPLACE_WITH_DOMAIN
# CERT_MIN_DAYS=21
