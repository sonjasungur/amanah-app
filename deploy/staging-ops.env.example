# /opt/amanah-staging/ops.env — settings for scripts/staging-cron.sh (no secrets in this file).
BASE_URL=http://127.0.0.1:3201
DISK_MAX_PERCENT=85
BACKUP_MAX_AGE_HOURS=26
BACKUP_KEEP_DAYS=7
RESTORE_MAX_AGE_DAYS=8
# Automatic nightly restore test — only after the owner approved a restore-check identity (docs 29 §2.3):
# AGE_IDENTITY=/root/.config/amanah-staging/restore-check.key
# Once HTTPS is live (variant B, docs 29 §4):
# CERT_HOST=staging.REPLACE_WITH_DOMAIN
# CERT_MIN_DAYS=21
