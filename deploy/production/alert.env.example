# /opt/amanah-prod/alert.env — root:root, mode 600. Never commit the real file.
# Nothing leaves the server until ALERT_EXTERNAL=true (owner approval of a channel).
ALERT_EXTERNAL=false
ALERT_REPEAT_HOURS=24
# Mail: ALERT_MAIL=true plus ALERT_SMTP_* / ALERT_MAIL_* (see scripts/staging-alert-mail.py)
# or a chat webhook that accepts {"text": "..."}:
# ALERT_WEBHOOK_URL=
