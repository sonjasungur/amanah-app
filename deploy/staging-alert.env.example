# /opt/amanah-staging/alert.env — root:root, mode 600. Never commit the real file.
# Nothing leaves the server until ALERT_EXTERNAL=true (owner approval, docs 29 §3).
ALERT_EXTERNAL=false
ALERT_REPEAT_HOURS=24
# ntfy push (app on the phone; topic name acts like a password, or use an access token):
# ALERT_NTFY_URL=https://ntfy.sh/REPLACE_WITH_LONG_RANDOM_TOPIC
# ALERT_NTFY_TOKEN=
# or a chat webhook that accepts {"text": "..."}:
# ALERT_WEBHOOK_URL=
