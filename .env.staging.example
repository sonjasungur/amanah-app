# Amanah staging — synthetic test data only. Copy to .env.staging (never commit) and
# generate staging-only values; never reuse production secrets or keys.
#   openssl rand -hex 32          → SESSION_SECRET, AMANAH_SANDBOX_WEBHOOK_SECRET
#   openssl rand -base64 32       → key part of AMANAH_DATA_KEYS
AMANAH_DEPLOYMENT_ENV=staging
NEXT_PUBLIC_AMANAH_ENVIRONMENT=staging
NODE_ENV=production
AMANAH_RELEASE=REPLACE_WITH_GIT_SHA

POSTGRES_USER=amanah_staging
POSTGRES_PASSWORD=REPLACE_WITH_STAGING_DB_PASSWORD
POSTGRES_DB=amanah_staging
DATABASE_URL=postgresql://amanah_staging:REPLACE_WITH_STAGING_DB_PASSWORD@postgres:5432/amanah_staging

SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS
AMANAH_DATA_KEYS=stg2026a:REPLACE_WITH_BASE64_32_BYTE_KEY
AMANAH_DATA_KEY_ACTIVE=stg2026a
AMANAH_DATA_ENCRYPTION=required

NEXT_PUBLIC_SITE_URL=https://staging.REPLACE_WITH_DOMAIN
AMANAH_PUBLIC_BASE_URL=https://staging.REPLACE_WITH_DOMAIN
NEXT_PUBLIC_AUTH_MODE=api
NEXT_PUBLIC_STORAGE_MODE=api
AMANAH_SERVER_STORAGE=postgres

# Only reserved test domains: no real person can register on staging
AMANAH_PUBLIC_REGISTRATION_ENABLED=true
NEXT_PUBLIC_AMANAH_PUBLIC_REGISTRATION_ENABLED=true
AMANAH_REGISTRATION_ALLOWED_DOMAINS=staging.invalid

# Mails stay in the in-memory outbox; nothing is delivered
AMANAH_MAIL_TRANSPORT=outbox
AMANAH_INTERNAL_TOOLS=true

AMANAH_BILLING_MODE=sandbox
AMANAH_BILLING_ENFORCE=false
AMANAH_SANDBOX_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS

AMANAH_AI_ENABLED=false
NEXT_PUBLIC_AMANAH_AI_ENABLED=false
AMANAH_AI_PROVIDER=rules

STAGING_APP_PORT=3201
# Encrypted backups of the staging database (scripts/backup-postgres.sh)
BACKUP_AGE_RECIPIENTS=REPLACE_WITH_AGE_PUBLIC_KEY
BACKUP_REQUIRE_ENCRYPTION=true
