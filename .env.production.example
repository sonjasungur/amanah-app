# AmanahOrdner — Production environment (copy to .env.production on server)
# NEVER commit .env.production with real secrets.

NODE_ENV=production

# --- Public site ---
NEXT_PUBLIC_SITE_URL=https://amanah.example.com
NEXT_PUBLIC_APP_URL=https://amanah.example.com

# --- Auth & storage (production defaults) ---
NEXT_PUBLIC_AUTH_MODE=api
NEXT_PUBLIC_STORAGE_MODE=api
AMANAH_SERVER_STORAGE=postgres

# --- Postgres (used by docker-compose.prod.yml) ---
POSTGRES_USER=amanah
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=amanah
# Internal Docker URL (compose overrides host for app service):
DATABASE_URL=postgresql://amanah:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/amanah?schema=public

# --- Session (min. 32 random characters) ---
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS
AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS

# --- Data encryption at rest (AES-256-GCM envelope encryption) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep keys outside the database and outside backups. Rotation: docs/strategy/15-verschluesselung-und-backup.md
AMANAH_DATA_KEYS=k2026a:REPLACE_WITH_BASE64_32_BYTE_KEY
AMANAH_DATA_KEY_ACTIVE=k2026a
AMANAH_DATA_ENCRYPTION=required

# --- Knowledge retrieval ---
AMANAH_KNOWLEDGE_RETRIEVAL=keyword
AMANAH_EMBEDDING_PROVIDER=none
AMANAH_EMBEDDING_MODEL=
AMANAH_KNOWLEDGE_TOP_K=3

# --- AI (rules = safe/cost-free default; openai optional) ---
AMANAH_AI_ENABLED=false
NEXT_PUBLIC_AMANAH_AI_ENABLED=false
AMANAH_AI_PROVIDER=rules
AMANAH_AI_MODEL_FAST=
AMANAH_AI_MODEL_SMART=
AI_PROVIDER=rules

AMANAH_PUBLIC_REGISTRATION_ENABLED=false
NEXT_PUBLIC_AMANAH_PUBLIC_REGISTRATION_ENABLED=false
# OPENAI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Accounts from before e-mail confirmation: days to confirm after the migration (0–365, default 60)
AMANAH_LEGACY_VERIFICATION_GRACE_DAYS=60

# Vorsorge Plus: keep AMANAH_BILLING_ENFORCE off until the owner approves; enforcement needs a launch date
# (accounts created before it keep all features)
# AMANAH_BILLING_ENFORCE=false
# AMANAH_PLUS_LAUNCH_AT=2027-01-01T00:00:00Z

# Transactional mail (only after owner approval and AVV): brevo | postmark | disabled
# Disable link/open tracking in the provider account as well.
AMANAH_MAIL_TRANSPORT=disabled
# AMANAH_MAIL_API_KEY=REPLACE_WITH_PROVIDER_KEY
# AMANAH_MAIL_FROM=noreply@REPLACE_WITH_DOMAIN
# AMANAH_MAIL_FROM_NAME=Mein Wille
